{
    "hooks":  {
                  "PostToolUse":  [
                                      {
                                          "matcher":  "Bash|apply_patch|Edit|Write|mcp__.*",
                                          "hooks":  [
                                                        {
                                                            "type":  "command",
                                                            "command":  "python \"$(git rev-parse --show-toplevel)/.codex/hooks/lambchop_post_tool_use.py\"",
                                                            "timeout":  30,
                                                            "statusMessage":  "Checking Lambchop evidence expectations"
                                                        }
                                                    ]
                                      }
                                  ],
                  "PreToolUse":  [
                                     {
                                         "matcher":  "Bash|apply_patch|Edit|Write|mcp__.*",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "python \"$(git rev-parse --show-toplevel)/.codex/hooks/lambchop_pre_tool_use.py\"",
                                                           "timeout":  30,
                                                           "statusMessage":  "Checking Lambchop safety guardrails"
                                                       }
                                                   ]
                                     }
                                 ],
                  "SessionStart":  [
                                       {
                                           "matcher":  "startup|resume|clear",
                                           "hooks":  [
                                                         {
                                                             "type":  "command",
                                                             "command":  "python \"$(git rev-parse --show-toplevel)/.codex/hooks/lambchop_session_start.py\"",
                                                             "timeout":  30,
                                                             "statusMessage":  "Loading Lambchop workflow context"
                                                         }
                                                     ]
                                       }
                                   ],
                  "Stop":  [
                               {
                                   "hooks":  [
                                                 {
                                                     "type":  "command",
                                                     "command":  "python \"$(git rev-parse --show-toplevel)/.codex/hooks/lambchop_stop.py\"",
                                                     "timeout":  30,
                                                     "statusMessage":  "Checking Lambchop completion evidence"
                                                 }
                                             ]
                               }
                           ],
                  "UserPromptSubmit":  [
                                           {
                                               "hooks":  [
                                                             {
                                                                 "type":  "command",
                                                                 "command":  "python \"$(git rev-parse --show-toplevel)/.codex/hooks/lambchop_user_prompt_submit.py\"",
                                                                 "timeout":  30,
                                                                 "statusMessage":  "Checking Lambchop intake policy"
                                                             }
                                                         ]
                                           }
                                       ]
              }
}
